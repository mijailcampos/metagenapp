import math


def build_kraken_index(raw_model, max_taxa_per_kmer=100000):
    """
    Construye el índice kraken-lite con pesos TF-IDF.

    TF  = frecuencia del kmer en la secuencia del taxon (ya viene en kmer_counts)
    IDF = log( N_taxa / df_kmer )
        donde df_kmer = número de taxa distintos que contienen ese kmer

    Efecto:
      - Kmers diagnósticos (únicos de Fusobacteria, Spirochaetes, etc.)
        reciben peso alto → el clasificador puede resolver phyla poco frecuentes
      - Kmers ubicuos (presentes en Proteobacteria + Firmicutes + todos)
        reciben peso bajo → reduce el sesgo hacia phyla grandes
    """
    k      = raw_model["kmer_size"]
    taxa   = raw_model["taxonomy_labels"]
    kmer_counts = raw_model["kmer_counts"]  # dict[kmer] -> dict[taxid] -> tf_count

    N_taxa = len(taxa)

    # ------------------------------------------------
    # 1. calcular df por kmer (en cuántos taxa aparece)
    # ------------------------------------------------
    kmer_df = {}  # kmer -> número de taxa distintos
    for kmer, taxid_counts in kmer_counts.items():
        kmer_df[kmer] = len(taxid_counts)

    # ------------------------------------------------
    # 2. construir índice con peso TF-IDF
    # ------------------------------------------------
    kmer_index = {}

    for kmer, taxid_counts in kmer_counts.items():

        df = kmer_df[kmer]

        # filtrar kmers que aparecen en demasiados taxa (ruido puro)
        if df > max_taxa_per_kmer:
            continue

        # IDF: log(N / df) — kmers únicos tienen IDF alto
        # +1 para evitar log(0) cuando df == N_taxa
        idf = math.log(N_taxa / (df + 1)) + 1.0

        # Si el kmer es completamente ubicuo (idf < 0.01), descartarlo
        if idf < 0.01:
            continue

        for taxid, tf in taxid_counts.items():
            tfidf = tf * idf

            if kmer not in kmer_index:
                kmer_index[kmer] = {}

            kmer_index[kmer][taxid] = tfidf

    return {
        "k": k,
        "taxonomy": taxa,
        "kmer_index": kmer_index
    }


def invert_kmer_counts_by_taxon(kmer_counts_by_taxon, taxa_labels):
    """
    Input:  kmer_counts_by_taxon: dict[taxon_label] -> dict[kmer] -> weight
            taxa_labels: list de taxon_label en orden taxid (si aplica)
    Output: dict[kmer] -> dict[taxid] -> weight
    """
    kmer_counts = {}
    for taxid, (taxon_label, kmers) in enumerate(kmer_counts_by_taxon.items()):
        for kmer, w in kmers.items():
            d = kmer_counts.get(kmer)
            if d is None:
                d = {}
                kmer_counts[kmer] = d
            d[taxid] = w
    return kmer_counts