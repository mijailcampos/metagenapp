set.dir(input=/data/validation_independent_mocks_20261111/input_mothur)
set.dir(output=/data/validation_independent_mocks_20261111/outputs/mothur)
make.file(inputdir=/data/validation_independent_mocks_20261111/input_mothur, type=fastq, prefix=stability)
make.contigs(file=stability.files, processors=16)
screen.seqs(fasta=stability.trim.contigs.fasta, count=stability.contigs.count_table, maxambig=0, minlength=430, maxlength=500, maxhomop=8)
unique.seqs(fasta=current, count=current)
align.seqs(fasta=current, reference=/data/databases/silva_138_2_seed/silva.seed_v138_2.pcr.align)
screen.seqs(fasta=current, count=current, start=6428, end=23440)
filter.seqs(fasta=current, vertical=T, trump=.)
unique.seqs(fasta=current, count=current)
pre.cluster(fasta=current, count=current, diffs=2)
chimera.vsearch(fasta=current, count=current, dereplicate=t)
remove.seqs(fasta=current, accnos=current)
classify.seqs(fasta=current, count=current, reference=/data/databases/silva_138_2/SILVA_138.2_SSURef_NR99_tax_silva_full_align_trunc.filtered.fasta, taxonomy=/data/databases/silva_138_2/silva_138_2_nr99_mothur.filtered.tax)
remove.lineage(fasta=current, count=current, taxonomy=current, taxon=Chloroplast-Mitochondria-unknown-Archaea-Eukaryota)
cluster.split(fasta=current, count=current, taxonomy=current, taxlevel=4, cutoff=0.03)
make.shared(list=current, count=current, label=0.03)
classify.otu(list=current, count=current, taxonomy=current, label=0.03)
